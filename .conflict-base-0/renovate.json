{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",

	"extends": ["config:best-practices"],

	"dependencyDashboard": true,

	"rangeStrategy": "auto",

	"prConcurrentLimit": 5,
	"prHourlyLimit": 2,

	"npm": {
		"enabled": false
	},

	"packageRules": [
		{
			"description": "Wails v3 framework",
			"matchPackageNames": ["github.com/wailsapp/wails/v3"],
			"ignoreUnstable": false,
			"respectLatest": false,
			"automerge": false,
			"groupName": "Wails v3"
		},

		{
			"description": "Wails v3 frontend runtime",
			"matchPackageNames": ["@wailsio/runtime"],
			"ignoreUnstable": false,
			"respectLatest": false,
			"automerge": false,
			"groupName": "Wails v3"
		},

		{
			"description": "Go dependencies",
			"matchManagers": ["gomod"],
			"matchUpdateTypes": ["patch"],
			"automerge": true,
			"automergeType": "pr"
		},

		{
			"description": "Frontend patch dependencies",
			"matchManagers": ["npm"],
			"matchUpdateTypes": ["patch"],
			"automerge": true,
			"automergeType": "pr"
		},

		{
			"description": "Major dependencies require review",
			"matchUpdateTypes": ["major"],
			"automerge": false
		}
	]
}
