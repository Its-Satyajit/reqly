<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="reqly"
        Arguments=""
        InstallLocation="C:\Program Files\reqly\Reqly">
    </Installer>
    <PackageInformation
        PackageName="Reqly"
        PackageDisplayName="Reqly"
        PublisherName="CN=reqly"
        PublisherDisplayName="reqly"
        Version="1.2.0.0"
        PackageDescription="A local-first, Git-native API development environment">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.reqly.reqly"
                Description="A local-first, Git-native API development environment"
                DisplayName="Reqly"
                ExecutableName="reqly"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Reqly</DisplayName>
            <PublisherDisplayName>reqly</PublisherDisplayName>
            <Description>A local-first, Git-native API development environment</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="reqly.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
